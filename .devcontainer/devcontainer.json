{
  "name": "Lean 4 class project",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "customizations": {
    "vscode": {
      "extensions": ["leanprover.lean4"],
      "settings" : {
        "editor.fontFamily": "Cascadia Code, Consolas, 'Courier New', monospace",
        "terminal.integrated.fontFamily": "Cascadia Code, Consolas, 'Courier New', monospace"
      }
    }
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:${containerEnv:HOME}/.elan/bin"
  },
  "postCreateCommand": "bash .devcontainer/install-lean.sh"
}
